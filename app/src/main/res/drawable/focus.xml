<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing until a keyboard, a controller or Switch Access puts focus here: Android only shows
     focus once something other than a finger is driving. The same patch marks a name, the time,
     a drawer row and the settings button, so focus looks like one thing wherever it is. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/focus_fill" android:state_focused="true" />
    <item android:drawable="@android:color/transparent" />
</selector>
