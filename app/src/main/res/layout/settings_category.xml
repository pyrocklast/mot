<?xml version="1.0" encoding="utf-8"?>
<!-- A group's heading in a settings list, with an optional note under it. Both are in the accent
     colour, so the note reads as part of the heading rather than as a row's summary, and
     TalkBack reads the two together as one heading. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:accessibilityHeading="true"
    android:orientation="vertical"
    android:screenReaderFocusable="true"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingTop="24dp"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingBottom="8dp"
    tools:viewBindingIgnore="true">

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="?android:attr/colorAccent"
        android:textSize="14sp" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/colorAccent"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
