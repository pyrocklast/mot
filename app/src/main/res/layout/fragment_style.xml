<?xml version="1.0" encoding="utf-8"?>
<!-- A style screen: a preview over your wallpaper (this area has no background, and the settings
     window shows the wallpaper), then the settings list below it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- A fixed height, so the preview stays put as things in it change size, or come and go -->
    <FrameLayout
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="@dimen/preview_height"
        android:paddingHorizontal="24dp"
        android:paddingVertical="24dp">

        <TextView
            android:id="@+id/namePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:lineSpacingExtra="8dp"
            android:maxLines="3"
            android:textSize="@dimen/app_name_size"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/clockPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <TextClock
                android:id="@+id/previewClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:maxLines="1"
                android:textSize="@dimen/clock_size" />

            <TextView
                android:id="@+id/previewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="3dp"
                android:textSize="@dimen/date_size" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/listContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/colorSurface" />

</LinearLayout>
