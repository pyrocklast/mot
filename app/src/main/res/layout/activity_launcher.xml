<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher: the home screen, with the app drawer as a panel over it. The home apps' names
     are added to homeApps from code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/clockBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:orientation="vertical">

            <!-- The time, kept current by the home screen's minute tick (TimeText) -->
            <TextView
                android:id="@+id/clock"
                style="@style/Mot.Text.Clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="9:41" />

            <TextView
                android:id="@+id/date"
                style="@style/Mot.Text.Date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="lundi 9 novembre" />
        </LinearLayout>

        <!-- Never scrolls: swiping up and down are gestures -->
        <LinearLayout
            android:id="@+id/homeApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="112dp"
            android:paddingBottom="48dp"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:id="@+id/tips"
            style="@style/Mot.Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="96dp"
            android:text="@string/tips"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/setDefault"
            style="@style/Mot.Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/set_as_home_underlined"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/launcherVeilColor"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- The search box starts on the time's line (HomeFit sets its top margin), so that
                 opening the drawer puts "Search" where the time was. The gap below it is fixed,
                 not a share of what's left: the keyboard takes room from the bottom of the drawer,
                 and a share of the rest would move the search box and the names with it -->
            <EditText
                android:id="@+id/search"
                style="@style/Mot.Text.Search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/drawer_gear"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textNoSuggestions"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:maxLines="1" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/drawer_below_search" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/appList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="24dp"
                    android:clipToPadding="false"
                    android:fadingEdgeLength="24dp"
                    android:layoutAnimation="@anim/layout_anim_from_bottom"
                    android:overScrollMode="ifContentScrolls"
                    android:requiresFadingEdge="vertical" />

                <!-- Says why the list is empty, where its first row would be -->
                <TextView
                    android:id="@+id/drawerEmpty"
                    style="@style/Mot.Text.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:alpha="0.7"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="16dp"
                    android:textColor="@color/launcher_text"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- The way into settings from here; a long press on the home screen does the same. It
             rides on the search box's line, which HomeFit places: see Drawer.placeHeader -->
        <ImageButton
            android:id="@+id/drawerSettings"
            android:layout_width="@dimen/drawer_gear"
            android:layout_height="@dimen/drawer_gear"
            android:layout_gravity="top|end"
            android:layout_marginEnd="12dp"
            android:alpha="0.6"
            android:background="@null"
            android:contentDescription="@string/settings"
            android:padding="14dp"
            android:src="@drawable/ic_settings" />
    </FrameLayout>

</FrameLayout>
