<?xml version="1.0" encoding="utf-8"?>
<!-- A small, dimmed row with a padlock: "Private space" at the end of your apps, and "Lock" at
     the end of Private Space's. Smaller than app names, so it doesn't read as an app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp">

    <TextView
        android:id="@+id/action"
        style="@style/Mot.Text.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:alpha="0.75"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingHorizontal="12dp"
        android:drawableStart="@drawable/ic_lock"
        android:drawableTint="?attr/launcherTextColor" />

</FrameLayout>
