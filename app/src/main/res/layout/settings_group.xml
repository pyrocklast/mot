<?xml version="1.0" encoding="utf-8"?>
<!-- A group of settings rows: an optional heading (with an optional note under it), then the
     rows on a rounded surface (Rows.kt adds them to groupRows). Space between groups and the
     surface behind each one, rather than lines, show which rows belong together. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp"
    tools:viewBindingIgnore="true">

    <!-- Lines up with the rows' text: the surface's margin plus the rows' own padding.
         TalkBack reads the heading and its note together, as one heading. A titled heading
         is also a button that collapses its rows; the word at its end says what a tap does. -->
    <LinearLayout
        android:id="@+id/groupHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:background="?attr/selectableItemBackground"
        android:minHeight="@dimen/touch_target"
        android:orientation="vertical"
        android:paddingStart="@dimen/settings_heading_inset"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/settings_heading_inset"
        android:paddingBottom="8dp"
        android:screenReaderFocusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@android:id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="?android:attr/colorAccent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/groupToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:importantForAccessibility="no"
                android:textColor="?android:attr/colorAccent"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/colorAccent"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- clipToOutline keeps the rows' touch ripples inside the rounded corners -->
    <LinearLayout
        android:id="@+id/groupRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/settings_group_margin"
        android:background="@drawable/settings_group"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:paddingVertical="4dp" />

</LinearLayout>
