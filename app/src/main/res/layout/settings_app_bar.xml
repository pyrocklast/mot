<?xml version="1.0" encoding="utf-8"?>
<!-- The settings screens' title bar, with Back. The frame takes the status bar's height as its top
     padding (SettingsScreen), so the bar itself keeps its usual height under it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/colorBackground">

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:navigationContentDescription="@string/back"
        android:navigationIcon="?android:attr/homeAsUpIndicator" />

</FrameLayout>
