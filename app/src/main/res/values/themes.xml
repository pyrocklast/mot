<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Settings, menus and dialogs: Android's own look, following the phone's dark mode and,
         on phones that have them, its Material You colours. No title bar from the theme: each
         settings screen has its own. -->
    <style name="Theme.Mot" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- The launcher: text over your wallpaper, edge to edge. Light text by default; the overlays
         below switch it to dark text, or to plain white or black. -->
    <style name="Theme.Mot.Launcher" parent="Theme.Mot">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:colorEdgeEffect">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Mot.WindowAnimation</item>
        <item name="android:forceDarkAllowed">false</item>

        <item name="launcherTextColor">@android:color/system_neutral1_50</item>
        <item name="launcherHintColor">#99FFFFFF</item>
        <item name="launcherShadowColor">#80000000</item>
        <item name="launcherVeilColor">#40000000</item>
    </style>

    <!-- Light text, for dark wallpapers: not white but the lightest of the colours Android takes
         from your wallpaper, so the words belong to the picture behind them -->
    <style name="ThemeOverlay.Mot.LightText" parent="">
        <item name="launcherTextColor">@android:color/system_neutral1_50</item>
        <item name="launcherHintColor">#99FFFFFF</item>
        <item name="launcherShadowColor">#80000000</item>
        <item name="launcherVeilColor">#40000000</item>
    </style>

    <!-- Dark text, for light wallpapers: the darkest of your wallpaper's colours -->
    <style name="ThemeOverlay.Mot.DarkText" parent="">
        <item name="launcherTextColor">@android:color/system_neutral1_900</item>
        <item name="launcherHintColor">#99000000</item>
        <item name="launcherShadowColor">#80FFFFFF</item>
        <item name="launcherVeilColor">#40FFFFFF</item>
    </style>

    <style name="Mot.WindowAnimation" parent="">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- Launcher text: your text colour, with a soft shadow that keeps it readable on busy wallpapers,
         in Android's own sans serif: the time bold, the date regular, app names light. -->
    <style name="Mot.Text" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/launcher_text</item>
        <item name="android:textColorHint">?attr/launcherHintColor</item>
        <item name="android:shadowColor">?attr/launcherShadowColor</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">4</item>
    </style>

    <style name="Mot.Text.AppName">
        <item name="android:textSize">@dimen/app_name_size</item>
        <item name="android:textFontWeight">300</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Mot.Text.Search" parent="Mot.Text.AppName">
        <item name="android:background">@null</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:hint">@string/search_hint</item>
        <item name="android:cursorVisible">false</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>

    <!-- Proportional figures, a touch closer together: tabular ones leave "11" gapped -->
    <style name="Mot.Text.Clock">
        <item name="android:textSize">@dimen/clock_size</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:fontFeatureSettings">pnum</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Mot.Text.Date">
        <item name="android:textSize">@dimen/date_size</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Mot.Text.Small">
        <item name="android:textSize">@dimen/small_size</item>
    </style>

</resources>
